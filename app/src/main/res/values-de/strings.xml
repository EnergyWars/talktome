    <string name="profile_group_self">ÜBER MICH</string>
    <string name="profile_self_label">Ich-Beschreibung</string>
    <string name="profile_self_help">Wie würdest du dich selbst beschreiben? Die KI-Berater nutzen das, um deine Nachrichten besser einzuordnen.</string>

    <string name="profile_group_partner">ÜBER MEINEN PARTNER</string>
    <string name="profile_partner_label">Partner-Beschreibung</string>
    <string name="profile_partner_help">Wie würdest du deinen Partner beschreiben? Hilft den KI-Beratern, seine Perspektive besser einzuschätzen.</string>

    <string name="profile_group_filter">FILTER</string>
    <string name="profile_filter_label">Was ich nicht lesen möchte</string>
    <string name="profile_filter_help">Beschreibe, welche Art von Nachrichten dich triggern oder verletzen könnte. Das bleibt geheim – dein Partner erfährt nie den Inhalt, nur ob eine Nachricht deswegen abgelehnt wurde.</string>

    <string name="gemini_privacy_title">Wichtiger Hinweis</string>
    <string name="gemini_privacy_body">Dein API-Schlüssel wird verschlüsselt nur auf diesem Gerät gespeichert. Deine Texte werden zur Verarbeitung an Google Gemini gesendet, aber niemals an deinen Partner oder einen Server dieser App.</string>
